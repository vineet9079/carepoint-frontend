{
  "name": "carepoint-frontend",
  "version": "1.0.3",
  "main": "main.js",
  "description": "CarePoint Hospital Management System",
  "author": "Vineet Kumar Prajapat",
  "repository": "github:vineet9079/carepoint-frontend",
 "scripts": {
  "dev": "vite",
  "build": "vite build",
  "electron:start": "vite build && electron .",
  "electron:build": "vite build && electron-builder",
  "publish:all": "vite build && electron-builder --win --x64 --arm64 --publish always"
},
  "build": {
    "appId": "com.carepoint.hms",
    "productName": "CarePoint HMS",
    "publish": [
      {
        "provider": "github",
        "owner": "vineet9079",
        "repo": "carepoint-frontend"
      }
    ],
    "directories": {
      "output": "dist_electron"
    },
    "win": {
      "target": "nsis",
      "icon": "carepoint-crisp-icon.ico"
    },
    "files": [
      "dist/**/*",
      "main.js"
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.26.1",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.6.1",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "vite": "^5.4.21"
  }
}